# Seed the runtime theme files that niri and ghostty read *before* any user session exists.
#
# niri includes ~/.local/state/theme/niri.kdl, and both a missing file and an empty colour are fatal:
# niri falls back to defaults with no keybinds, and ghostty refuses its theme pointer. Home Manager
# cannot help, because niri reads its config before HM activation runs. Seeding at system activation
# removes the ordering problem instead of racing it.
#
# The values are resolved here, at build time, from the repository palette. They are NOT parsed during
# activation: the activation PATH contains coreutils and grep but no sed, so a script that called sed
# silently produced empty colours - which is exactly how a fresh install ended up with
# `active-color ""` and a desktop that would not start. Nothing here can be empty: every required key
# is read from themes/gruvbox/colors.toml, and a missing one fails the build instead of the boot.
#
# theme-apply owns these files afterwards. A file that already has real values is never touched, so a
# reboot cannot clobber the active theme; a file with empty values is treated as broken and replaced.
{ config, lib, ... }:

let
  inherit (builtins) filter head match readFile;
  inherit (lib) splitString;

  userName = config.my.username;

  stateDir = "${config.my.home}/.local/state/theme";

  # Single source of truth for the seeded palette.
  paletteLines = splitString "\n" (readFile ../themes/gruvbox/colors.toml);

  paletteValue = key:
    let
      hit = l: match "[ \t]*${key}[ \t]*=[ \t]*\"(.*)\"" l;
      hits = filter (l: hit l != null) paletteLines;
    in
    if hits == [ ] then "" else head (hit (head hits));

  value = key:
    let
      v = paletteValue key;
    in
    if v == "" then
      throw "theme-seed: themes/gruvbox/colors.toml has no \"${key}\" - refusing to seed a broken theme file"
    else
      v;

  # Border colours fall back to the fg/muted pair, the same rule theme-apply uses.
  borderActive =
    let
      v = paletteValue "border_active";
    in
    if v != "" then v else value "foreground";

  borderInactive =
    let
      v = paletteValue "border_inactive";
    in
    if v != "" then v else value "muted";

  ghosttyTheme = ''
    background = ${value "background"}
    foreground = ${value "foreground"}
    cursor-color = ${value "accent"}
    cursor-text = ${value "background"}
    selection-background = ${value "selection"}
    selection-foreground = ${value "foreground"}
    palette = 0=${value "darker_background"}
    palette = 1=${value "red"}
    palette = 2=${value "green"}
    palette = 3=${value "yellow"}
    palette = 4=${value "blue"}
    palette = 5=${value "magenta"}
    palette = 6=${value "cyan"}
    palette = 7=${value "light_foreground"}
    palette = 8=${value "muted"}
    palette = 9=${value "bright_red"}
    palette = 10=${value "bright_yellow"}
    palette = 11=${value "bright_green"}
    palette = 12=${value "bright_blue"}
    palette = 13=${value "bright_magenta"}
    palette = 14=${value "bright_cyan"}
    palette = 15=${value "bright_foreground"}
  '';

  niriTheme = ''
    // Generated by theme-apply - theme: gruvbox. Do not edit, it is rewritten on every switch.
    layout {
        border {
            on
            width 2
            active-color "${borderActive}"
            inactive-color "${borderInactive}"
        }
    }
  '';
in
{
  system.activationScripts.seedThemeState = {
    deps = [ "users" "etc" ];

    text = ''
      theme_state=${stateDir}

      install -d -m 0755 -o ${userName} -g users ${config.my.home}/.local
      install -d -m 0755 -o ${userName} -g users ${config.my.home}/.local/state
      install -d -m 0755 -o ${userName} -g users "$theme_state"

      # A file is (re)written when it is missing, empty, or carries an empty value. That last case is
      # what a bad boot leaves behind, and it must not survive: both consumers treat it as fatal.
      needs_write() {
        [ -s "$1" ] || return 0
        ! grep -q . "$1" && return 0
        grep -q '""' "$1" && return 0
        grep -qE '=[[:space:]]*$' "$1" && return 0
        return 1
      }

      if needs_write "$theme_state/niri.kdl"; then
        cat >"$theme_state/niri.kdl.tmp" <<'THEME_EOF'
${niriTheme}
THEME_EOF
        chown ${userName}:users "$theme_state/niri.kdl.tmp"
        chmod 0644 "$theme_state/niri.kdl.tmp"
        mv -f "$theme_state/niri.kdl.tmp" "$theme_state/niri.kdl"
      fi

      if needs_write "$theme_state/ghostty"; then
        cat >"$theme_state/ghostty.tmp" <<'THEME_EOF'
${ghosttyTheme}
THEME_EOF
        chown ${userName}:users "$theme_state/ghostty.tmp"
        chmod 0644 "$theme_state/ghostty.tmp"
        mv -f "$theme_state/ghostty.tmp" "$theme_state/ghostty"
      fi
    '';
  };
}
