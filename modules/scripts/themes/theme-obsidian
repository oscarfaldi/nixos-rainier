.markdown-rendered code {{ color: {code}; }}
.cm-s-obsidian span.cm-keyword {{ color: {magenta}; }}
.cm-s-obsidian span.cm-string {{ color: {yellow}; }}
.cm-s-obsidian span.cm-number {{ color: {yellow}; }}
.cm-s-obsidian span.cm-comment {{ color: {text_faint}; }}
.cm-s-obsidian span.cm-operator {{ color: {blue}; }}
.cm-s-obsidian span.cm-def {{ color: {blue}; }}
.markdown-rendered a {{ color: var(--link-color); }}
.markdown-rendered blockquote {{ border-left-color: var(--blockquote-border-color); }}
.workspace-leaf.mod-active .workspace-leaf-header-title {{ color: var(--interactive-accent); }}
.nav-file-title.is-active {{ color: {link}; }}
.search-result-file-title {{ color: {link}; }}
"""


def main():
    if len(sys.argv) < 2 or len(sys.argv) > 3:
        return die("usage: theme-obsidian <colors.toml> [gtk-theme-dir]")
    palette_path = sys.argv[1]
    gtk_dir = sys.argv[2] if len(sys.argv) == 3 else ""
    try:
        palette = parse_palette(palette_path)
    except OSError as exc:
        return die(f"cannot read {palette_path}: {exc}")
    if not HEX.match(palette.get("background", "")) or not HEX.match(palette.get("foreground", "")):
        return die(f"{palette_path} has no usable background/foreground")

    gtk = gtk_defines(gtk_dir)
    if not gtk.get("base"):
        print(f"theme-obsidian: no GTK theme at {gtk_dir!r}, surfaces derived from the palette",
              file=sys.stderr)

    c = build(palette, gtk)
    name = os.path.basename(os.path.dirname(os.path.abspath(palette_path)))
    heat = c["heat"]

    out = CSS.format(
        name=name, **c,
        heat0=heat[0], heat1=heat[1], heat2=heat[2], heat3=heat[3], heat4=heat[4],
        highlight=mix(c["surface"], c["yellow"], 0.22),
        tag_bg=mix(c["surface"], c["yellow"], 0.14),
        h1=c["heads"][0], h2=c["heads"][1], h3=c["heads"][2],
        h4=c["heads"][3], h5=c["heads"][4], h6=c["heads"][5],
    )
    sys.stdout.write(out)

    # Report the pairs that decide whether this reads as one desktop (stderr so the CSS stays clean).
    print(f"theme-obsidian: {name} surface={c['surface']} chrome={c['chrome']} card={c['card']} "
          f"edge={c['edge']}", file=sys.stderr)
    print(f"theme-obsidian: text {contrast(c['text'], c['surface']):.2f}:1, muted "
          f"{contrast(c['text_muted'], c['surface']):.2f}:1, faint "
          f"{contrast(c['text_faint'], c['surface']):.2f}:1, link "
          f"{contrast(c['link'], c['surface']):.2f}:1, card-vs-page deltaE "
          f"{delta_e(c['card'], c['surface']):.1f}, heat4 {heat[4]} "
          f"(on-cell text {contrast(c['heat_text'], heat[4]):.2f}:1)", file=sys.stderr)
    print("theme-obsidian: heat ladder " +
          " -> ".join(f"{h}(dE {delta_e(h, c['surface']):.0f})" for h in heat), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
