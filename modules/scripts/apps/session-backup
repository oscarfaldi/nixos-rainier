#!/usr/bin/env bash

# Snapshot chat-app sessions to the NAS toolkit share.
#
# The share is a passive repository: nothing on the NAS runs, and the only reader is
# `bootstrap_session` in install, which copies a session back on a fresh system.
# This script is the only writer, and it has to run on the PC with the apps CLOSED:
# these directories hold live SQLite/leveldb state, and copying them while the app
# runs produces a profile that will not open afterwards.
#
# Layout on the share, one folder per app:
#   toolkit/<App>/<app>-session.tar.gz  (+ .sha256 and version.txt), all 0600
#
# Adding an app is one line at the bottom. The fields are:
#   label | parent to archive from | entry to archive | share folder | archive name |
#   pgrep pattern for "it is running" | binary for version.txt | [tar excludes]
#
# A proc pattern of "-" disables the running check. Only the keyring uses it: the daemon
# is always up, and its files are small enough to copy while it idles.

set -uo pipefail

NAS_ROOT="/mnt/nas/toolkit"
STATUS=0

if [[ ! -d "$NAS_ROOT" ]]; then
    echo "The NAS toolkit share is not mounted at $NAS_ROOT" >&2
    exit 1
fi

snapshot() {
    local label="$1"
    local parent="$2"
    local dir="$3"
    local dest="$4"
    local tar="$5"
    local proc="$6"
    local binary="$7"
    shift 7

    local excludes=()
    local pattern
    for pattern in "$@"; do
        excludes+=("--exclude=$pattern")
    done

    if [ "$proc" != "-" ] && pgrep -f "$proc" >/dev/null; then
        echo "SKIP $label: it is running. Close it, then run session-backup again." >&2
        STATUS=1
        return 0
    fi

    if [[ ! -d "$parent/$dir" ]]; then
        echo "SKIP $label: nothing to snapshot at $parent/$dir" >&2
        return 0
    fi

    local stage
    stage="$(mktemp -d)" || { STATUS=1; return 0; }

    if ! tar -C "$parent" -czf "$stage/$tar" ${excludes[@]+"${excludes[@]}"} "$dir"; then
        echo "FAILED $label: tar returned an error" >&2
        STATUS=1
        rm -rf "$stage"
        return 0
    fi

    ( cd "$stage" && sha256sum "$tar" > "$tar.sha256" )

    mkdir -p "$NAS_ROOT/$dest"
    install -m 0600 "$stage/$tar" "$NAS_ROOT/$dest/$tar"
    install -m 0600 "$stage/$tar.sha256" "$NAS_ROOT/$dest/$tar.sha256"

    # Which build produced the profile: a major jump is the one case where the
    # restored session may not open and a fresh login is required. An app that is not
    # on PATH yet (run once through `nix run`, or added before the rebuild) leaves the
    # file alone instead of writing an empty one.
    if path="$(command -v "$binary" 2>/dev/null)" && [ -n "$path" ]; then
        readlink -f "$path" > "$NAS_ROOT/$dest/version.txt" 2>/dev/null || true
    fi

    echo "OK   $label -> $NAS_ROOT/$dest/$tar ($(du -h "$stage/$tar" | cut -f1))"
    rm -rf "$stage"
}

snapshot "ZapZap" "$HOME/.local/share" "ZapZap" "ZapZap" "zapzap-session.tar.gz" \
    "[.]zapzap-wrapped" "zapzap"

snapshot "Discord" "$HOME/.config" "discord" "Discord" "discord-session.tar.gz" \
    "[.]Discord-wrapped" "discord" \
    "discord/Cache" "discord/Code Cache" "discord/GPUCache" \
    "discord/DawnGraphiteCache" "discord/DawnWebGPUCache" "discord/Crashpad" \
    "discord/discord_asset_cache" "discord/logs" "discord/sentry"

# Telegram Desktop keeps the whole login in tdata/ (its own encrypted key material
# included), so the archive is the session. The media cache inside tdata/user_data is
# dropped: it is the bulk of the directory and Telegram rebuilds it.
# The packaged binary is called `Telegram` (not telegram-desktop), so both the launcher
# and the wrapped child match on `Telegram`.
snapshot "Telegram" "$HOME/.local/share" "TelegramDesktop" "Telegram" "telegram-session.tar.gz" \
    "[T]elegram" "Telegram" \
    "TelegramDesktop/log.txt" \
    "TelegramDesktop/tdata/user_data/cache" "TelegramDesktop/tdata/user_data/media_cache"

# Spotify's login is the autologin.blob entry inside the profile-level prefs file, not
# the per-account directory: Users/<name>-user only holds preferences and playback state.
# The whole directory is 36K, so it is archived as-is and the cache stays out of it
# because Spotify keeps that under ~/.cache. The blob is encrypted, but whether it
# survives a restore onto a freshly installed system is unproven - treat it as a time
# saver, not a guarantee, and expect a re-login if it fails to unlock.
snapshot "Spotify" "$HOME/.config" "spotify" "Spotify" "spotify-session.tar.gz" \
    "[s]potify" "spotify"

# Edge Sync already restores bookmarks, saved passwords and history from the Microsoft
# account, so the profile is only archived for what sync cannot carry: the cookie jar
# (site sessions, and the Spotify hand-off the desktop app uses), first-run state, and
# per-extension settings. Extensions themselves are dropped - 800M of unpacked store
# builds that sync reinstalls on the next launch - along with every cache.
snapshot "Edge" "$HOME/.config" "microsoft-edge" "Edge" "edge-session.tar.gz" \
    "[m]icrosoft-edge" "microsoft-edge" \
    "microsoft-edge/Default/Extensions" \
    "microsoft-edge/Default/Service Worker" \
    "microsoft-edge/Default/IndexedDB" \
    "microsoft-edge/Default/Cache" \
    "microsoft-edge/Default/Code Cache" \
    "microsoft-edge/Default/GPUCache" \
    "microsoft-edge/Default/DawnGraphiteCache" \
    "microsoft-edge/Default/DawnWebGPUCache" \
    "microsoft-edge/Default/load_statistics.db" \
    "microsoft-edge/GPUPersistentCache" \
    "microsoft-edge/component_crx_cache" \
    "microsoft-edge/extensions_crx_cache" \
    "microsoft-edge/BrowserMetrics" \
    "microsoft-edge/Crash Reports" \
    "microsoft-edge/WidevineCdm"

# The login keyring is where Chromium keeps the "Chromium Safe Storage" secret, and Edge
# encrypts both the cookie jar and Login Data with it. Restoring the profile without this
# file gives a browser whose passwords and sessions cannot be decrypted, so the two
# archives only make sense as a pair. It also unlocks with the login password, which means
# a reinstall that sets a different password cannot use the restored copy.
snapshot "Keyring" "$HOME/.local/share" "keyrings" "Keyring" "keyring-session.tar.gz" \
    "-" "-"

exit "$STATUS"
