#!/usr/bin/env bash
set -uo pipefail

# ============================================================
# Inspect File (v2.2)
#
# Universal metadata inspector for Thunar.
#
# UI:
#   A report window drawn by the Quickshell shell (popups/DialogWindow.qml).
#
# Dependencies:
#   - ffmpeg (ffprobe)
#   - exiftool
#   - poppler (pdfinfo)
#   - xdg-utils
# ============================================================

if [[ $# -eq 0 ]]; then
    echo "inspect-file: no file selected" >&2
    notify-send "Inspect File" "No file selected." 2>/dev/null || true
    exit 1
fi

FILE="$1"
[[ -L "$FILE" ]] && FILE="$(readlink -f "$FILE")"

if [[ ! -e "$FILE" ]]; then
    echo "inspect-file: file not found: $FILE" >&2
    notify-send "Inspect File" "File not found." 2>/dev/null || true
    exit 1
fi

FNAME="$(basename "$FILE")"
EXT="${FNAME##*.}"
EXT="${EXT,,}"

# Report renderer: a REAL window in the Quickshell shell (theme, tiling, resize, close key).
# The contract is one line into the
# shell's command FIFO: `dialog <kind> <path>`; the first line of the report is `TITLE: <title>`.
REPORT="${XDG_RUNTIME_DIR:-/tmp}/qs-report-inspect.txt"

show_report() {
    # IPC, not the command FIFO: the FIFO is tuned for keybind latency, while a report dialog is
    # already slow (ffprobe/exiftool/smartctl) and needs a guaranteed delivery. `qs ipc` costs ~40 ms.
    local state="${XDG_RUNTIME_DIR:-/tmp}/quickshell-shell.pid"
    local pid=""
    # `read` fails at EOF when the file has no trailing newline; keep whatever it managed to read.
    [ -r "$state" ] && { read -r pid < "$state" || true; }

    if [ -z "${pid:-}" ] || [ ! -r "/proc/$pid/comm" ]; then
        pid=$(pgrep -f "quickshell -p ${HOME}/System/.config/quickshell/main" | head -1)
    fi

    [ -n "${pid:-}" ] || return 1

    qs ipc --pid "$pid" call shell run "dialog $1 $2" >/dev/null 2>&1 || return 1
    return 0
}


# ============================================================
# Helpers
# ============================================================

line() {
    printf "%-18s %s\n" "$1:" "${2:-N/A}"
}

# A blank line goes BETWEEN sections, never before the first one: the report has to start on its
# heading (the dialog trims it anyway).
SECTION_FIRST=1

section() {
    if [[ $SECTION_FIRST == 1 ]]; then
        SECTION_FIRST=0
    else
        echo
    fi
    echo "$1"
    printf '%*s\n' "${#1}" '' | sed 's/ /─/g'
}

exif() {
    exiftool -s3 -c '%.6f' "-$1" "$FILE" 2>/dev/null | head -1 || true
}

# Raw numeric EXIF (GPS as signed decimal coordinates, without N/S/E/W).
exif_n() {
    exiftool -n -s3 "-$1" "$FILE" 2>/dev/null | head -1 | tr -d ' ' || true
}

exif_first() {
    local tag val
    for tag in "$@"; do
        val="$(exif "$tag")"
        if [[ -n "$val" ]]; then
            echo "$val"
            return
        fi
    done
}

probe() {
    ffprobe -v quiet "$@" "$FILE" 2>/dev/null || true
}

mime() {
    xdg-mime query filetype "$FILE" 2>/dev/null || echo "unknown"
}

size_bytes() {
    stat -c%s "$FILE" 2>/dev/null || echo 0
}

size_human() {
    numfmt --to=iec --suffix=B "$(size_bytes)" 2>/dev/null || echo "$(size_bytes) bytes"
}

duration_fmt() {
    local d
    d="$1"

    awk -v d="$d" '
    BEGIN{
        if(d==""){print "N/A"; exit}
        h=int(d/3600)
        m=int((d%3600)/60)
        s=int(d%60)

        if(h>0)
            printf "%02d:%02d:%02d",h,m,s
        else
            printf "%02d:%02d",m,s
    }'
}

fps_fmt() {
    awk -F/ '
    {
        if($2>0)
            printf "%.3f",$1/$2
    }'
}

bitrate_fmt() {
    local b="$1"
    [[ -z "$b" ]] && return
    numfmt --to=iec --suffix=b "$b" 2>/dev/null || echo "$b bps"
}

device_name() {
    local make model other

    make="$(exif Make)"
    model="$(exif Model)"

    if [[ -n "$make" && -n "$model" ]]; then
        if [[ "$make" == "$model" ]]; then
            echo "$model"
        else
            echo "$make $model"
        fi
        return
    fi

    other="$(exif_first CameraModelName DeviceModelName AndroidModel DeviceName)"
    if [[ -n "$other" ]]; then
        echo "$other"
        return
    fi

    if [[ -n "$model" ]]; then
        echo "$model"
        return
    fi

    echo "$make"
}

# Container format with a clean name (MP4, MOV, Matroska, etc.).
container_name() {
    local ct
    ct="$(exif FileType)"
    if [[ -n "$ct" ]]; then
        echo "$ct"
        return
    fi
    probe -show_entries format=format_name -of default=nw=1:nk=1 | cut -d, -f1
}

# Reformat EXIF datetime from "YYYY:MM:DD HH:MM:SS" to "DD-MM-YYYY HH:MM:SS".
format_date_local() {
    local raw="$1"
    [[ -z "$raw" ]] && return
    printf '%s' "$raw" | sed -E 's/^([0-9]{4}):([0-9]{2}):([0-9]{2}) /\3-\2-\1 /'
}

# Video recording date: MP4 timestamps are stored in UTC and converted
# to the system's local timezone.
# Output: "DD-MM-YYYY HH:MM:SS +ZZZZ"
# Example: 30-11-2024 22:32:33 +0700
# Indonesian month names (requires id_ID.UTF-8 locale):
#   date -d "$norm UTC" +'%d %B %Y %H:%M:%S %z'
recorded_date() {
    local raw norm out
    raw="$(exif_first MediaCreateDate CreateDate DateTimeOriginal)"
    [[ -z "$raw" ]] && return

    norm="$(printf '%s' "$raw" | sed -E \
        -e 's/^([0-9]{4}):([0-9]{2}):([0-9]{2}) /\1-\2-\3 /' \
        -e 's/[+-][0-9]{2}:?[0-9]{2}$//' \
        -e 's/Z$//')"

    if out="$(date -d "$norm UTC" +'%d-%m-%Y %H:%M:%S %z' 2>/dev/null)"; then
        echo "$out"
    else
        printf '%s' "$raw"
    fi
}

hdr_format() {
    local transfer primaries
    transfer="$(probe -select_streams v:0 -show_entries stream=color_transfer -of default=nw=1:nk=1)"
    primaries="$(probe -select_streams v:0 -show_entries stream=color_primaries -of default=nw=1:nk=1)"

    case "$transfer" in
        smpte2084)
            echo "HDR10 / PQ"
            ;;
        arib-std-b67)
            echo "HLG"
            ;;
        *)
            if [[ -z "$transfer" && -z "$primaries" ]]; then
                echo "Unknown"
            elif [[ "$primaries" == bt2020 ]]; then
                echo "BT.2020"
            else
                echo "SDR"
            fi
            ;;
    esac
}

rotation_label() {
    local r="$1"
    [[ -z "$r" ]] && return
    case "$r" in
        90)   echo "90° (Portrait)" ;;
        180)  echo "180° (Upside Down)" ;;
        270)  echo "270° (Portrait)" ;;
        0)    echo "Landscape" ;;
        *)    echo "$r°" ;;
    esac
}

is_lossless() {
    local c="${1,,}"
    case "$c" in
        flac|alac|ape|tta|wavpack|mlp|truehd) return 0 ;;
        pcm_*)                                  return 0 ;;
        *)                                      return 1 ;;
    esac
}

audio_quality() {
    local codec bitdepth samplerate
    codec="$(probe -select_streams a:0 -show_entries stream=codec_name -of default=nw=1:nk=1)"
    bitdepth="$(probe -select_streams a:0 -show_entries stream=bits_per_raw_sample -of default=nw=1:nk=1)"
    samplerate="$(probe -select_streams a:0 -show_entries stream=sample_rate -of default=nw=1:nk=1)"
    echo "$codec|$bitdepth|$samplerate"
}

video_gps() {
    exif_first GPSCoordinates GPSPosition Location
}

# Convert coordinate strings ("6.145500 S, 106.846100 E" or ISO 6709
# "+37.7858-122.4064+0/") into signed decimal "latitude longitude" format.
coord_to_dec_pair() {
    local s="$1"
    [[ -z "$s" ]] && return

    s="$(printf '%s' "$s" | tr -d ' ')"
    s="$(printf '%s' "$s" | sed -E \
        's/([0-9]+(\.[0-9]+)?)[Ss]/-\1/g;
         s/([0-9]+(\.[0-9]+)?)[Ww]/-\1/g;
         s/([0-9]+(\.[0-9]+)?)[Nn]/\1/g;
         s/([0-9]+(\.[0-9]+)?)[Ee]/\1/g')"

    printf '%s' "$s" | grep -oE '[-+]?[0-9]+(\.[0-9]+)?' | head -2 | tr '\n' ' '
}

video_gps_dec() {
    local coord pair lat lon
    coord="$(video_gps)"
    [[ -z "$coord" ]] && return

    pair="$(coord_to_dec_pair "$coord")"
    lat=""; lon=""
    read -r lat lon _ <<< "$pair"

    [[ -z "$lat" || -z "$lon" ]] && return
    lat="${lat#+}"; lon="${lon#+}"
    echo "$lat, $lon"
}

gps_maps_link() {
    local lat lon coord pair

    lat="$(exif_n GPSLatitude)"
    lon="$(exif_n GPSLongitude)"

    if [[ -z "$lat" || -z "$lon" ]]; then
        coord="$(video_gps)"
        if [[ -n "$coord" ]]; then
            pair="$(coord_to_dec_pair "$coord")"
            lat=""; lon=""
            read -r lat lon _ <<< "$pair"
        fi
    fi

    [[ -z "$lat" || -z "$lon" ]] && return
    lat="${lat#+}"; lon="${lon#+}"
    echo "https://maps.google.com/?q=$lat,$lon"
}

# ============================================================
# File
# ============================================================

build_file_info() {

    section "FILE INFO"

    line "Name" "$FNAME"
    line "Path" "$(dirname "$FILE")"
    line "Extension" "$EXT"
    line "MIME" "$(mime)"
    line "Size" "$(size_human) ($(size_bytes) bytes)"
    line "Permissions" "$(stat -c '%A %U:%G' "$FILE" 2>/dev/null || echo N/A)"
    line "Modified" "$(stat -c '%y' "$FILE" 2>/dev/null | sed 's/\.[0-9]* /  /')"
    line "Created" "$(stat -c '%w' "$FILE" 2>/dev/null || echo N/A)"
}

# ============================================================
# Video
# ============================================================

build_video() {

    section "VIDEO"

    line "Container" "$(container_name)"

    line "Codec" "$(
        probe -select_streams v:0 \
        -show_entries stream=codec_name \
        -of default=nw=1:nk=1
    )"

    line "Codec ID" "$(
        probe -select_streams v:0 \
        -show_entries stream=codec_tag_string \
        -of default=nw=1:nk=1
    )"

    line "Resolution" "$(
        probe -select_streams v:0 \
        -show_entries stream=width,height \
        -of csv=p=0:s=x
    )"

    line "Aspect Ratio" "$(
        probe -select_streams v:0 \
        -show_entries stream=display_aspect_ratio \
        -of default=nw=1:nk=1
    )"

    line "Frame Rate" "$(
        probe -select_streams v:0 \
        -show_entries stream=r_frame_rate \
        -of default=nw=1:nk=1 | fps_fmt
    ) fps"

    line "Bit Depth" "$(
        probe -select_streams v:0 \
        -show_entries stream=bits_per_raw_sample \
        -of default=nw=1:nk=1
    )"

    line "Pixel Format" "$(
        probe -select_streams v:0 \
        -show_entries stream=pix_fmt \
        -of default=nw=1:nk=1
    )"

    local dur
    dur="$(probe -show_entries format=duration -of default=nw=1:nk=1)"
    line "Duration" "$(duration_fmt "$dur")"

    local br
    br="$(probe -show_entries format=bit_rate -of default=nw=1:nk=1)"
    line "Bitrate" "$(bitrate_fmt "$br")"

    section "AUDIO TRACK"

    line "Codec" "$(
        probe -select_streams a:0 \
        -show_entries stream=codec_name \
        -of default=nw=1:nk=1
    )"

    line "Channels" "$(
        probe -select_streams a:0 \
        -show_entries stream=channels \
        -of default=nw=1:nk=1
    )"

    line "Sample Rate" "$(
        probe -select_streams a:0 \
        -show_entries stream=sample_rate \
        -of default=nw=1:nk=1
    ) Hz"

    local abr
    abr="$(
        probe -select_streams a:0 \
        -show_entries stream=bit_rate \
        -of default=nw=1:nk=1
    )"
    line "Bitrate" "$(bitrate_fmt "$abr")"

    section "RECORDING"

    line "Device" "$(device_name)"
    line "Recorded" "$(recorded_date)"
    line "Orientation" "$(rotation_label "$(exif Rotation)")"

    section "LOCATION"

    line "GPS" "$(video_gps_dec)"
    line "Google Maps" "$(gps_maps_link)"

    section "COLOR"

    line "HDR Format" "$(hdr_format)"

    line "Color Space" "$(
        probe -select_streams v:0 \
        -show_entries stream=color_space \
        -of default=nw=1:nk=1
    )"

    line "Color Range" "$(
        probe -select_streams v:0 \
        -show_entries stream=color_range \
        -of default=nw=1:nk=1
    )"

    line "Primaries" "$(
        probe -select_streams v:0 \
        -show_entries stream=color_primaries \
        -of default=nw=1:nk=1
    )"

    line "Transfer" "$(
        probe -select_streams v:0 \
        -show_entries stream=color_transfer \
        -of default=nw=1:nk=1
    )"
}

# ============================================================
# Audio
# ============================================================

build_audio() {

    local codec bitdepth samplerate br dur
    IFS='|' read -r codec bitdepth samplerate <<< "$(audio_quality)"

    section "AUDIO"

    line "Codec" "$codec"

    br="$(probe -show_entries format=bit_rate -of default=nw=1:nk=1)"
    line "Bitrate" "$(bitrate_fmt "$br")"

    line "Channels" "$(
        probe -select_streams a:0 \
        -show_entries stream=channels \
        -of default=nw=1:nk=1
    )"

    dur="$(probe -show_entries format=duration -of default=nw=1:nk=1)"
    line "Duration" "$(duration_fmt "$dur")"

    section "QUALITY"

    if is_lossless "$codec"; then
        line "Lossless" "Yes"
    else
        line "Lossless" "No"
    fi

    if [[ "$codec" == mp3 ]]; then
        line "VBR" "$(exif_first VariableBitRate VBR)"
    fi

    line "Bit Depth" "$bitdepth"
    line "Sample Rate" "${samplerate:+$samplerate Hz}"

    section "TAGS"

    line "Title" "$(exif Title)"
    line "Artist" "$(exif Artist)"
    line "Album Artist" "$(exif AlbumArtist)"
    line "Album" "$(exif Album)"
    line "Genre" "$(exif Genre)"
    line "Year" "$(exif Year)"
    line "Track" "$(exif Track)"
    line "Disc" "$(exif PartOfSet)"
    line "Composer" "$(exif Composer)"
    line "Publisher" "$(exif Publisher)"
    line "Copyright" "$(exif Copyright)"
    line "ISRC" "$(exif ISRC)"
    line "ReplayGain" "$(exif ReplayGainTrackGain)"
    line "Comment" "$(exif Comment)"
}

# ============================================================
# Image
# ============================================================

build_image() {

    section "IMAGE"

    local w h fnum res
    w="$(exif ImageWidth)"
    h="$(exif ImageHeight)"

    if [[ -n "$w" && -n "$h" ]]; then
        res="$w x $h"
        line "Resolution" "$res"
        line "Megapixels" "$(awk "BEGIN{printf \"%.1f MP\",$w*$h/1000000}")"
    else
        line "Resolution" ""
    fi

    line "Bit Depth" "$(exif BitDepth)"
    line "Color Space" "$(exif ColorSpace)"
    line "ICC Profile" "$(exif ProfileDescription)"

    section "CAMERA"

    line "Camera" "$(device_name)"
    line "Lens" "$(exif LensModel)"
    line "ISO" "$(exif ISO)"
    line "Shutter" "$(exif ExposureTime)"

    fnum="$(exif FNumber)"
    line "Aperture" "${fnum:+f/$fnum}"

    line "Focal Length" "$(exif FocalLength)"
    line "Flash" "$(exif Flash)"
    line "Software" "$(exif Software)"
    line "Captured" "$(format_date_local "$(exif DateTimeOriginal)")"
    line "Orientation" "$(exif Orientation)"

    section "LOCATION"

    line "Latitude" "$(exif_n GPSLatitude)"
    line "Longitude" "$(exif_n GPSLongitude)"
    line "Altitude" "$(exif GPSAltitude)"
    line "Google Maps" "$(gps_maps_link)"
}

# ============================================================
# PDF
# ============================================================

build_pdf() {

    section "DOCUMENT"

    local info
    info="$(pdfinfo "$FILE" 2>/dev/null || true)"

    awk -F': *' '
    /^Title:|^Author:|^Creator:|^Producer:|^Pages:|^PDF version:|^CreationDate:|^ModDate:/{
        printf "%-18s %s\n",$1":",$2
    }' <<<"$info"
}

# ============================================================
# Office
# ============================================================

build_office() {

    section "DOCUMENT"

    line "Title" "$(exif Title)"
    line "Author" "$(exif Author)"
    line "Last Editor" "$(exif LastModifiedBy)"
    line "Company" "$(exif Company)"
    line "Application" "$(exif Application)"
    line "Revision" "$(exif Revision)"
    line "Pages" "$(exif Pages)"
    line "Words" "$(exif Words)"
    line "Sheets" "$(exif Sheets)"
    line "Slides" "$(exif Slides)"
    line "Created" "$(exif CreateDate)"
    line "Modified" "$(exif ModifyDate)"
}

# ============================================================
# Text
# ============================================================

build_text() {

    section "CONTENT"

    line "Lines" "$(wc -l <"$FILE" 2>/dev/null || echo N/A)"
    line "Words" "$(wc -w <"$FILE" 2>/dev/null || echo N/A)"
    line "Characters" "$(wc -c <"$FILE" 2>/dev/null || echo N/A)"

    section "PREVIEW"

    head -20 "$FILE" 2>/dev/null || true
}

# ============================================================
# Generic
# ============================================================

build_generic() {

    section "METADATA"

    exiftool -s2 "$FILE" 2>/dev/null | head -80 || true
}

# ============================================================
# Main
# ============================================================

{
echo "TITLE: Properties - $FNAME"
build_file_info

case "$EXT" in

    mp4|mkv|mov|webm|avi|mts|m2ts|ts|mxf|mpeg|mpg|flv|3gp|ogv|wmv|m4v)
        build_video ;;

    mp3|flac|wav|aac|m4a|ogg|opus|wma|aiff|ape|alac)
        build_audio ;;

    jpg|jpeg|png|gif|bmp|webp|avif|heic|heif|jxl|tif|tiff|svg|cr2|cr3|nef|arw|dng|raf|orf|rw2)
        build_image ;;

    pdf)
        build_pdf ;;

    doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp|odg)
        build_office ;;

    txt|md|json|yaml|yml|toml|ini|cfg|conf|xml|html|css|js|ts|py|sh|bash|zsh|fish|nix|rs|go|java|c|cpp|hpp|csv|log)
        build_text ;;

    *)
        build_generic ;;

esac

} > "$REPORT"

if ! show_report inspect "$REPORT"; then
    # No shell window could be shown: print the report, so a terminal run still shows something.
    cat "$REPORT"
fi

exit 0
