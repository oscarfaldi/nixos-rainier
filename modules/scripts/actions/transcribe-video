# ============================================================
# Quickshell job reporting
#
# qs-job starts this script with QS_JOB_STATUS pointing at a key=value file that the shell's job
# window polls to draw the progress bar. Without it (a plain terminal run) every call is a no-op.
# ============================================================

JOB_PATH = os.environ.get("QS_JOB_STATUS", "")

JOB_STATE = {
    "title": "Transcribe to SRT",
    "state": "running",
    "file": "",
    "detail": "",
    "index": "1",
    "total": "1",
    "percent": "0.0",
    "speed": "0.00",
    "eta": "--:--:--",
    "message": "",
}


def job_write(**fields: str) -> None:
    """Rewrite the status file atomically; a reader never sees half a file."""

    if not JOB_PATH:
        return

    JOB_STATE.update(fields)

    tmp = f"{JOB_PATH}.tmp"

    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            for key, value in JOB_STATE.items():
                handle.write(f"{key}={value}\n")
        os.replace(tmp, JOB_PATH)
    except OSError:
        pass


def job_cancelled_by_signal(signum, frame) -> None:
    """The window's cancel button signals the process group; report it before dying."""

    job_write(state="cancelled", message="cancelled")

    # os._exit, not sys.exit: the main thread is parked in faster-whisper"s C code while the model
    # loads, so a SystemExit would only be raised once that call returns - the job looked alive for
    # minutes after CANCEL. Nothing to flush here, the partial SRT is handled by the caller.
    os._exit(130)


signal.signal(signal.SIGTERM, job_cancelled_by_signal)
signal.signal(signal.SIGINT, job_cancelled_by_signal)



# ============================================================
# Configuration
# ============================================================

# Model
#
# large-v3        = highest accuracy, slower
# large-v3-turbo  = strong accuracy, much faster
# medium / small  = faster still, more accuracy trade-off
MODEL = "large-v3-turbo"

# Main language is Indonesian.
# English words/phrases are still allowed naturally in the transcript.
LANGUAGE = "id"

# Current setup: CPU
DEVICE = "cpu"

# INT8 is preferable for CPU inference.
# If DEVICE is changed to "cuda", use float16.
COMPUTE_TYPE = "int8" if DEVICE == "cpu" else "float16"

# Prioritize speed over maximum decoding accuracy.
# 1 = greedy decoding / fastest
BEAM_SIZE = 1

# Ignore long stretches without speech.
VAD_FILTER = True

# Word-level timestamps let us build short, mobile-friendly subtitles
# instead of blindly using Whisper's long segment boundaries.
WORD_TIMESTAMPS = True

# Subtitle pacing
#
# Prefer natural 7-9 word captions, while allowing shorter or slightly
# longer groups when the phrasing and timing make more sense.
IDEAL_WORDS = 8
MIN_WORDS = 4
SOFT_MAX_WORDS = 9
SHORT_CAPTION_MAX_WORDS = 10
MAX_CAPTION_DURATION = 3.8
SHORT_CAPTION_MAX_DURATION = 2.2
MAX_CHARS_PER_LINE = 38
MAX_TOTAL_CHARS = 76
PAUSE_BREAK_SECONDS = 0.40

# Domain vocabulary/context commonly used in your content.
# Keep this focused on words likely to recur in your actual videos.
INITIAL_PROMPT = (
    "Indonesian content about business, productivity, personal branding, "
    "content creation, marketing, branding, sales, audience, attention, "
    "retention, algorithm, monetization, conversion, long form, short form, "
    "creator, leverage, automation, startup, SaaS, API, AI, ChatGPT, Claude, "
    "Gemini, OpenAI, Anthropic, YouTube, TikTok, Instagram, social media."
)


