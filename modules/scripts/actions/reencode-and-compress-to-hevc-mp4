#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# Re-encode and Compress to HEVC MP4
#
# Re-encode selected videos to HEVC using NVIDIA NVENC, with
# the goal of reducing file size while maintaining broad
# playback compatibility.
#
# Video:
#   Codec        : HEVC (H.265)
#   Profile      : Main
#   Preset       : P5
#   Rate Control : Constant QP (24)
#   Lookahead    : 20
#   Spatial AQ   : ON
#   AQ Strength  : 4
#   Tag          : hvc1 (Apple compatibility)
#
# Audio:
#   Copy original stream
#
# Container:
#   MP4
#
# Output:
#   <filename>-encoded.mp4
#
# Supports:
#   - Single file
#   - Multiple selected files
#   - Folder selection (non-recursive)
#
# Intended for Thunar Custom Actions using %F.
# ============================================================

notify() {
    notify-send "$1" "$2"
}

get_output_path() {
    local input="$1"
    echo "${input%.*}-encoded.mp4"
}

is_video_file() {
    case "${1,,}" in
        *.mkv|*.mp4|*.m4v|*.mov|*.avi|*.wmv|*.asf|*.webm|*.mpg|*.mpeg|*.m2ts|*.mts|*.ts|*.mxf|*.flv|*.f4v|*.ogv|*.3gp|*.3g2|*.vob|*.divx)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# ============================================================
# Quickshell job reporting
#
# qs-job starts this script with QS_JOB_STATUS pointing at a key=value file that the shell's job
# window polls to draw the progress bar. The file is replaced atomically, so a reader never sees
# half a line. Without QS_JOB_STATUS (a plain terminal run) every call here is a no-op and the
# script behaves exactly as before.
# ============================================================

JOB_TITLE="Re-encode to HEVC MP4"
JOB_STATE="running"
JOB_FILE=""
JOB_DETAIL=""
JOB_INDEX="0"
JOB_TOTAL="1"
JOB_PERCENT="0.0"
JOB_SPEED="0.00"
JOB_ETA="00:00:00"
JOB_MESSAGE=""

job_write() {
    [[ -n "${QS_JOB_STATUS:-}" ]] || return 0

    {
        printf 'title=%s\n' "$JOB_TITLE"
        printf 'state=%s\n' "$JOB_STATE"
        printf 'file=%s\n' "$JOB_FILE"
        printf 'detail=%s\n' "$JOB_DETAIL"
        printf 'percent=%s\n' "$JOB_PERCENT"
        printf 'speed=%s\n' "$JOB_SPEED"
        printf 'eta=%s\n' "$JOB_ETA"
        printf 'index=%s\n' "$JOB_INDEX"
        printf 'total=%s\n' "$JOB_TOTAL"
        printf 'message=%s\n' "$JOB_MESSAGE"
    } >"$QS_JOB_STATUS.tmp" 2>/dev/null && mv -f "$QS_JOB_STATUS.tmp" "$QS_JOB_STATUS" 2>/dev/null || true

    return 0
}

# ============================================================
# Collect Files
# ============================================================

files=()

if [[ "$#" -eq 0 ]]; then
    notify \
        "Re-encode and Compress to HEVC MP4" \
        "No input file or folder specified."

    exit 1
fi

for input in "$@"; do

    if [[ -d "$input" ]]; then

        while IFS= read -r -d '' file; do

            if is_video_file "$file"; then
                files+=("$file")
            fi

        done < <(
            find "$input" \
                -maxdepth 1 \
                -type f \
                -print0
        )

    elif [[ -f "$input" ]]; then

        if is_video_file "$input"; then
            files+=("$input")
        else
            notify \
                "Re-encode and Compress to HEVC MP4" \
                "$(basename "$input") is not a supported video file."
        fi

    else

        notify \
            "Re-encode and Compress to HEVC MP4" \
            "Invalid path: $(basename "$input")"

    fi

done

total=${#files[@]}

if [[ "$total" -eq 0 ]]; then
    JOB_TOTAL="0"
    JOB_INDEX="0"
    JOB_STATE="done"
    JOB_PERCENT="100.0"
    JOB_MESSAGE="no supported videos found"
    job_write

    notify \
        "Re-encode and Compress to HEVC MP4" \
        "No supported videos found."

    exit 0
fi

# ============================================================
# Processing Session
# ============================================================

set +e


files=( "$@" )

total=${#files[@]}
current=0
success=0
failed=0

total_original=0
total_final=0

session_start=$(date +%s)

tmp=""
ffmpeg_log=""


cleanup() {
    echo
    echo
    echo "Interrupted."

    [[ -n "$tmp" && -f "$tmp" ]] && rm -f "$tmp"
    [[ -n "$ffmpeg_log" && -f "$ffmpeg_log" ]] && rm -f "$ffmpeg_log"

    echo
    echo "Source files were not intentionally deleted."
    echo

    JOB_STATE="cancelled"
    JOB_MESSAGE="cancelled - temporary output removed"
    job_write

    exit 130
}

trap cleanup INT TERM

echo
echo "============================================================"
echo " RE-ENCODE AND COMPRESS TO HEVC MP4"
echo "============================================================"
echo "Files       : $total"
echo "Codec       : HEVC"
echo "Preset      : P5"
echo "QP          : 24"
echo "Audio       : Copy"
echo "Container   : MP4"
echo "Tag         : hvc1"
echo "Faststart   : Enabled"
echo "============================================================"

for input in "${files[@]}"; do

    current=$((current + 1))

    filename="$(basename "$input")"

    JOB_FILE="$filename"
    JOB_DETAIL="[$current/$total]"
    JOB_INDEX="$current"
    JOB_TOTAL="$total"
    JOB_STATE="running"
    JOB_PERCENT="0.0"
    JOB_SPEED="0.00"
    JOB_ETA="00:00:00"
    JOB_MESSAGE=""
    job_write
    output="${input%.*}-encoded.mp4"

    tmp="${output}.nvenc-tmp.mp4"
    ffmpeg_log="${tmp}.log"

    # MP4 can only store text subtitles, as mov_text: those are converted so nothing is lost. A bitmap
    # subtitle (PGS/VobSub) has no MP4 form at all, so it is reported in the log instead of silently
    # disappearing - the source file still carries it.
    sub_args=()
    sub_codecs=()
    sub_dropped=()
    sub_out=0

    while IFS= read -r sub_codec; do
        [[ -n "$sub_codec" ]] && sub_codecs+=("$sub_codec")
    done < <(ffprobe \
        -v error \
        -select_streams s \
        -show_entries stream=codec_name \
        -of default=noprint_wrappers=1:nokey=1 \
        "$input" 2>/dev/null)

    for sub_index in "${!sub_codecs[@]}"; do
        case "${sub_codecs[$sub_index]}" in
            subrip|ass|ssa|mov_text|webvtt|text)
                sub_args+=(-map "0:s:$sub_index" -c:s:"$sub_out" mov_text)
                sub_out=$((sub_out + 1))
                ;;
            *)
                sub_dropped+=("${sub_codecs[$sub_index]}")
                ;;
        esac
    done

    if [[ "${#sub_dropped[@]}" -gt 0 ]]; then
        echo "[SUBTITLE] dropped ${sub_dropped[*]} - MP4 cannot store bitmap subtitles"
    fi


    rm -f "$tmp" "$ffmpeg_log"

    echo
    echo "============================================================"
    echo "[$current/$total] $filename"
    echo "============================================================"
    echo "Source : $input"
    echo "Output : $output"
    echo

    duration=$(ffprobe \
        -v error \
        -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 \
        "$input")

    if [[ -z "$duration" ]]; then

        JOB_STATE="failed"
        JOB_MESSAGE="failed - source file preserved"
        job_write

        echo "[FAILED] Could not determine video duration."
        echo "Source file preserved."

        failed=$((failed + 1))

        rm -f "$tmp" "$ffmpeg_log"

        tmp=""
        ffmpeg_log=""

        continue
    fi

    original_size=$(stat -c%s "$input")
    encode_start=$(date +%s)

    ffmpeg \
        -hide_banner \
        -loglevel warning \
        -hwaccel_device 0 \
        -hwaccel cuda \
        -init_hw_device cuda=hw \
        -filter_hw_device hw \
        -hwaccel_output_format cuda \
        -i "$input" \
        -map 0:v:0 \
        -map "0:a?" \
        "${sub_args[@]}" \
        -dn \
        -c:v hevc_nvenc \
        -gpu 0 \
        -preset p5 \
        -profile:v main \
        -tag:v hvc1 \
        -rc constqp \
        -qp 24 \
        -rc-lookahead 20 \
        -spatial-aq 1 \
        -aq-strength 4 \
        -c:a copy \
        -movflags +faststart \
        -y \
        -progress pipe:1 \
        -nostats \
        "$tmp" \
        2>"$ffmpeg_log" |
    while IFS="=" read -r key value; do

        if [[ "$key" == "out_time_us" ]]; then

            current_us="$value"

            current_seconds=$(awk \
                "BEGIN {print $current_us / 1000000}")

            percent=$(awk \
                -v current="$current_seconds" \
                -v total="$duration" \
                "BEGIN {
                    if (total > 0)
                        printf \"%.1f\", (current / total) * 100
                    else
                        print \"0.0\"
                }")

            elapsed=$(($(date +%s) - encode_start))

            speed=$(awk \
                -v current="$current_seconds" \
                -v elapsed="$elapsed" \
                "BEGIN {
                    if (elapsed > 0)
                        printf \"%.2f\", current / elapsed
                    else
                        print \"0.00\"
                }")

            eta=$(awk \
                -v current="$current_seconds" \
                -v total="$duration" \
                -v elapsed="$elapsed" \
                "BEGIN {
                    if (current > 0)
                        printf \"%.0f\", (total-current)*elapsed/current
                    else
                        print 0
                }")

            eta_h=$((eta / 3600))
            eta_m=$(((eta % 3600) / 60))
            eta_s=$((eta % 60))

            JOB_PERCENT="$percent"
            JOB_SPEED="$speed"
            JOB_ETA=$(printf '%02d:%02d:%02d' "$eta_h" "$eta_m" "$eta_s")
            job_write

            # A terminal gets the live line; the job log must stay readable, and the window already
            # shows percent, speed and ETA in the bars.
            if [[ -t 1 ]]; then
                printf "\rProgress: %6s%% | Speed: %5sx | ETA: %02d:%02d:%02d" \
                    "$percent" \
                    "$speed" \
                    "$eta_h" \
                    "$eta_m" \
                    "$eta_s"
            fi

        fi

    done

    ffmpeg_exit_code=${PIPESTATUS[0]}

    set -e

    echo

    # ==================================================
    # Success
    # ==================================================

    if [[ "$ffmpeg_exit_code" -eq 0 && -s "$tmp" ]]; then

        touch -r "$input" "$tmp"

        final_size=$(stat -c%s "$tmp")

        total_original=$((total_original + original_size))
        total_final=$((total_final + final_size))

        encode_elapsed=$(($(date +%s) - encode_start))

        encode_h=$((encode_elapsed / 3600))
        encode_m=$(((encode_elapsed % 3600) / 60))
        encode_s=$((encode_elapsed % 60))

        size_difference=$((final_size - original_size))

        if [[ "$original_size" -gt 0 ]]; then
            percent_difference=$(awk \
                -v original="$original_size" \
                -v final="$final_size" \
                "BEGIN {
                    printf \"%.1f\", (final/original-1)*100
                }")
        else
            percent_difference="0.0"
        fi

        mv -f "$tmp" "$output"
        rm -f "$input"

        echo
        JOB_STATE="done"
        JOB_PERCENT="100.0"
        JOB_MESSAGE="$(numfmt --to=iec "$original_size") -> $(numfmt --to=iec "$final_size")"
        job_write

        echo "[OK] Re-encode and compression complete!"
        echo
        echo "Source : $(numfmt --to=iec "$original_size")"
        echo "Output : $(numfmt --to=iec "$final_size")"

        if [[ "$size_difference" -lt 0 ]]; then

            saved=$((-size_difference))

            saved_percent=$(awk \
                -v original="$original_size" \
                -v final="$final_size" \
                "BEGIN {
                    printf \"%.1f\", (1-final/original)*100
                }")

            echo "Saved  : $(numfmt --to=iec "$saved") (-$saved_percent%)"

        elif [[ "$size_difference" -gt 0 ]]; then

            increase="$size_difference"

            increase_percent=$(awk \
                -v original="$original_size" \
                -v final="$final_size" \
                "BEGIN {
                    printf \"%.1f\", (final/original-1)*100
                }")

            echo "Saved  : +$(numfmt --to=iec "$increase") (+$increase_percent%)"

        else

            echo "Saved  : 0 B (0.0%)"

        fi

        printf "Elapsed: %02d:%02d:%02d\n" \
            "$encode_h" \
            "$encode_m" \
            "$encode_s"

        echo "Output : $(basename "$output")"

        # ffmpeg's own stderr goes to a file and used to be shown only on failure. A video can
        # "succeed" and still lose a stream or a broken header, so surface the warnings in the job log.
        if [[ -s "$ffmpeg_log" ]]; then
            echo
            echo "FFmpeg warnings:"
            sed 's/^/  /' "$ffmpeg_log"
        fi

        success=$((success + 1))

    # ==================================================
    # Failure
    # ==================================================

    else

        echo
        JOB_STATE="failed"
        JOB_MESSAGE="failed - source file preserved"
        job_write

        echo "[FAILED] Re-encode and compression failed."
        echo
        echo "Source file preserved."
        echo "Temporary output removed."

        if [[ -s "$ffmpeg_log" ]]; then

            echo
            echo "FFmpeg output:"
            echo "------------------------------------------------------------"

            sed "s/^/  /" "$ffmpeg_log"

            echo "------------------------------------------------------------"

        else

            echo
            echo "FFmpeg did not provide additional error output."
            echo "Exit code: $ffmpeg_exit_code"

        fi

        rm -f "$tmp"

        failed=$((failed + 1))

    fi

    rm -f "$ffmpeg_log"

    tmp=""
    ffmpeg_log=""

done

# ====================================================
# Summary
# ====================================================

session_end=$(date +%s)
session_elapsed=$((session_end - session_start))

echo
echo
echo "============================================================"
echo " RE-ENCODE AND COMPRESS COMPLETE"
echo "============================================================"
echo "Processed     : $current/$total"
echo "Successful    : $success"
echo "Failed        : $failed"
echo

echo "Original size : $(numfmt --to=iec "$total_original")"
echo "Final size    : $(numfmt --to=iec "$total_final")"

if [[ "$total_original" -gt 0 ]]; then

    total_difference=$((total_final - total_original))

    if [[ "$total_difference" -lt 0 ]]; then

        total_saved=$((-total_difference))

        total_saved_percent=$(awk \
            -v original="$total_original" \
            -v final="$total_final" \
            "BEGIN {
                printf \"%.1f\", (1-final/original)*100
            }")

        echo "Space saved   : $(numfmt --to=iec "$total_saved") (-$total_saved_percent%)"

    elif [[ "$total_difference" -gt 0 ]]; then

        total_increase="$total_difference"

        total_increase_percent=$(awk \
            -v original="$total_original" \
            -v final="$total_final" \
            "BEGIN {
                printf \"%.1f\", (final/original-1)*100
            }")

        echo "Saved         : +$(numfmt --to=iec "$total_increase") (+$total_increase_percent%)"

    else

        echo "Saved         : 0 B (0.0%)"

    fi

else

    echo "Space change  : N/A"

fi

session_h=$((session_elapsed / 3600))
session_m=$(((session_elapsed % 3600) / 60))
session_s=$((session_elapsed % 60))

echo
printf "Elapsed       : %02d:%02d:%02d\n" \
    "$session_h" \
    "$session_m" \
    "$session_s"

echo
echo "============================================================"
echo

# ============================================================
# Terminal state for the progress window
#
# A run that processed nothing (input already in the target container, no matching file) never
# reaches the per-file success/failure branches, so the window would poll forever. Always close the
# job out with what the summary counted.
# ============================================================

JOB_PERCENT="100.0"

if [[ "${failed:-0}" -gt 0 && "${success:-0}" -eq 0 ]]; then
    JOB_STATE="failed"
    JOB_MESSAGE="no file was processed"
else
    JOB_STATE="done"
    JOB_MESSAGE="${success:-0} done, ${failed:-0} failed"
fi

job_write
