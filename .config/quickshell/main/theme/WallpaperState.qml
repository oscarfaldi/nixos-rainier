pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Live wallpaper path for the whole shell.
//
// The path comes from `$XDG_STATE_HOME/theme/wallpaper`, the one file `theme-apply` rewrites on a
// theme switch and `wallpaper-next` rewrites when Ctrl+Tab rotates the gallery. Nothing here is
// generated by Nix: the state file stays the source of truth, so changing the wallpaper never needs
// a rebuild and no path is baked into QML.
//
// The shell DRAWS the wallpaper itself (see main/wallpaper/Wallpaper.qml) instead of handing the job
// to a separate daemon: no daemon to start, no socket to reconnect, no startup order to lose.
QtObject {
    id: root

    readonly property string statePath: Quickshell.env("HOME") + "/.local/state/theme/wallpaper"

    property string path: ""

    // file:// URL for the Image. Empty until the state file exists, which leaves the window on the
    // palette background colour instead of a broken image.
    readonly property url source: root.path !== "" ? "file://" + root.path : ""

    function load(text) {
        const value = String(text || "").trim();

        if (value !== root.path)
            root.path = value;
    }

    // Declared as a PROPERTY: QtObject has no default property, so a bare `FileView { }` child would
    // be a parse error. Same pattern as ThemeState.
    //
    // The watcher only TRIGGERS a re-read: `fileChanged` fires before the new content is loaded, and
    // reading text() inside it returns the previous line (measured), which is why a wallpaper change
    // looked like it did nothing. `loaded` is the signal that carries fresh text.
    property FileView file: FileView {
        path: root.statePath

        watchChanges: true
        printErrors: false

        onLoaded: root.load(text())
        onFileChanged: root.file.reload()
    }

    // The watcher cannot follow a file that does not exist yet, and on a fresh install theme-apply
    // writes it a moment after the shell starts. Reading a local file is local work, so this is not
    // a race workaround: the timer stops for good as soon as the path is known.
    property Timer probe: Timer {
        interval: 250
        repeat: true
        running: root.path === ""

        onTriggered: root.file.reload()
    }

    Component.onCompleted: root.file.reload()
}
