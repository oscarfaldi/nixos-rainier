pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Live palette for the whole shell.
//
// The values come from `$XDG_STATE_HOME/theme/theme.json`, which `theme-apply` rewrites on every
// switch. Nothing here is generated by Nix: a theme change must not need a rebuild, so the state
// file is the source of truth and `reload()` re-reads it after the script has written it.
//
// This is a SINGLETON on purpose. Theme.qml used to be a plain type that ~29 components
// instantiated as `Theme { }`; if the file read lived there, every instance would spawn its own
// reader. One singleton, one read, and every `Theme.bg` binding updates at once.
QtObject {
    id: root

    readonly property string statePath: Quickshell.env("HOME") + "/.local/state/theme/theme.json"

    // Fallback = Omarchy's gruvbox, i.e. what the shell shows before the first theme-apply (or if
    // the state file ever goes missing). Never leave a colour undefined here: half the shell binds
    // to these.
    property string name: "gruvbox"
    property string background: "#282828"
    property string panelColor: "#282828"
    property string foreground: "#d4be98"
    property string mutedText: "#665c54"
    property string accentText: "#7daea3"
    property string warningText: "#ea6962"
    property string successText: "#a9b665"

    readonly property color bg: root.background
    readonly property color bgAlpha: "#99" + String(root.background).replace("#", "")

    // Popup/panel surface: its own colour so a palette with a near-black background can lift the
    // dialogs and menus without lightening every window. Falls back to `background` when the palette
    // does not set one.
    readonly property color panel: root.panelColor
    readonly property color panelAlpha: "#e6" + String(root.panelColor).replace("#", "")
    readonly property color fg: root.foreground
    readonly property color muted: root.mutedText
    readonly property color accent: root.accentText
    readonly property color warning: root.warningText
    readonly property color success: root.successText

    function load(text) {
        let data = {};

        try {
            data = JSON.parse(String(text || "{}"));
        } catch (error) {
            console.warn("ThemeState: unreadable theme.json, keeping the current palette");
            return;
        }

        if (typeof data.name === "string" && data.name !== "")
            root.name = data.name;
        if (typeof data.background === "string" && data.background !== "")
            root.background = data.background;
        root.panelColor = (typeof data.panel === "string" && data.panel !== "")
                ? data.panel
                : ((typeof data.background === "string" && data.background !== "") ? data.background : root.panelColor);
        if (typeof data.foreground === "string" && data.foreground !== "")
            root.foreground = data.foreground;
        if (typeof data.muted === "string" && data.muted !== "")
            root.mutedText = data.muted;
        if (typeof data.accent === "string" && data.accent !== "")
            root.accentText = data.accent;
        if (typeof data.warning === "string" && data.warning !== "")
            root.warningText = data.warning;
        if (typeof data.success === "string" && data.success !== "")
            root.successText = data.success;
    }

    function reload() {
        // A Process must not be stopped and restarted in the same tick: that silently drops the new
        // run. Only stop it when it is actually running.
        if (root.reader.running)
            root.reader.running = false;

        root.reader.running = true;
    }

    // Declared as a PROPERTY: QtObject has no default property, so a bare `Process { }` child is a
    // parse error ("Cannot assign to non-existent default property").
    property Process reader: Process {
        command: ["cat", root.statePath]

        stdout: StdioCollector {
            onStreamFinished: root.load(text)
        }
    }

    Component.onCompleted: root.reload()
}
