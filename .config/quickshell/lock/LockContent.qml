// Lock screen content: themed wallpaper blur, clock, date, password prompt, CAPS hint, PAM auth.
//
// Colours come from the same theme.json the rest of the shell reads, so the lock follows the palette
// without any extra wiring. The blurred wallpaper is generated by theme-apply (state/lock-bg.jpg) -
// doing the blur once per theme switch is far cheaper than blurring in Qt on every lock, and it keeps
// this screen dependent on nothing but an image file.
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Services.Pam

Item {
  id: root

  property color bg: "#070d0b"
  property color panel: "#1a2b24"
  property color fg: "#e8dfc7"
  property color accent: "#4c8272"
  property color errorColor: "#e06c75"
  property color muted: "#45625a"

  property string statusText: ""
  property bool statusIsError: false
  property bool busy: false
  property bool capsOn: false
  property string password: ""

  signal unlocked()

  // ---------------------------------------------------------------- theme
  FileView {
    id: themeFile
    path: Quickshell.env("HOME") + "/.local/state/theme/theme.json"
    watchChanges: true
    onFileChanged: reload()
    onLoaded: {
      try {
        const data = JSON.parse(text());
        if (data.background) root.bg = data.background;
        if (data.panel) root.panel = data.panel;
        if (data.foreground) root.fg = data.foreground;
        if (data.accent) root.accent = data.accent;
        if (data.muted) root.muted = data.muted;
        if (data.warning) root.errorColor = data.warning;
      } catch (e) {
        // keep the defaults above; a lock screen must render even with a broken theme file
      }
    }
  }

  // ---------------------------------------------------------------- clock
  property string clockText: Qt.formatTime(new Date(), "hh:mm")
  property string dateText: Qt.formatDate(new Date(), "dddd, d MMMM yyyy")

  Timer {
    interval: 1000
    running: true
    repeat: true
    onTriggered: {
      const now = new Date();
      root.clockText = Qt.formatTime(now, "hh:mm");
      root.dateText = Qt.formatDate(now, "dddd, d MMMM yyyy");
    }
  }

  // ---------------------------------------------------------------- caps lock
  // No keyboard-layout service in Quickshell 0.3, so read the LED state. One long-running process
  // rather than a timer that spawns a shell four times a second.
  Process {
    running: true
    command: ["sh", "-c",
      "while :; do " +
      "s=0; for f in /sys/class/leds/*capslock*/brightness; do [ \"$(cat $f 2>/dev/null)\" = \"1\" ] && s=1; done; " +
      "echo $s; sleep 0.25; done"]
    stdout: SplitParser {
      onRead: line => root.capsOn = line.trim() === "1"
    }
  }

  // ---------------------------------------------------------------- pam
  PamContext {
    id: pam
    config: "qs-lock"
    user: Quickshell.env("USER")

    onCompleted: result => {
      root.busy = false;
      if (result === PamResult.Success) {
        root.statusText = "";
        root.unlocked();
      } else if (result === PamResult.MaxTries) {
        root.statusIsError = true;
        root.statusText = "Too many attempts - wait a moment";
        root.password = "";
      } else {
        root.statusIsError = true;
        root.statusText = "Wrong password";
        root.password = "";
        root.shake.restart();
      }
    }

    onError: err => {
      root.busy = false;
      root.statusIsError = true;
      root.statusText = "Authentication unavailable (" + err + ")";
      root.password = "";
    }

    // The QML-facing signal is `pamMessage` and it carries no arguments; read the properties instead.
    onPamMessage: {
      if (pam.message.length > 0) {
        root.statusIsError = pam.messageIsError;
        root.statusText = pam.message;
      }
    }

    onResponseRequiredChanged: {
      if (pam.responseRequired)
        field.forceActiveFocus();
    }
  }

  // ---------------------------------------------------------------- visuals
  Rectangle {
    anchors.fill: parent
    color: root.bg
  }

  Image {
    anchors.fill: parent
    source: "file://" + Quickshell.env("HOME") + "/.local/state/theme/lock-bg.jpg"
    fillMode: Image.PreserveAspectCrop
    asynchronous: true
    cache: false
    visible: status === Image.Ready
  }

  // theme-tinted veil so text stays readable on any wallpaper
  Rectangle {
    anchors.fill: parent
    color: Qt.rgba(root.panel.r, root.panel.g, root.panel.b, 0.55)
  }

  Column {
    anchors.centerIn: parent
    spacing: 0
    width: Math.min(parent.width - 80, 520)

    Text {
      width: parent.width
      horizontalAlignment: Text.AlignHCenter
      text: root.clockText
      color: root.fg
      style: Text.Raised
      styleColor: Qt.rgba(root.bg.r, root.bg.g, root.bg.b, 0.55)
      font.family: "JetBrainsMono Nerd Font"
      font.pixelSize: 96
      font.weight: Font.Light
    }

    Text {
      width: parent.width
      topPadding: 10
      bottomPadding: 42
      horizontalAlignment: Text.AlignHCenter
      text: root.dateText
      color: root.fg
      opacity: 0.85
      font.family: "JetBrainsMono Nerd Font"
      font.pixelSize: 20
      font.letterSpacing: 0.5
    }

    Text {
      width: parent.width
      bottomPadding: 10
      horizontalAlignment: Text.AlignHCenter
      text: Quickshell.env("USER")
      color: root.fg
      opacity: 0.7
      font.family: "JetBrainsMono Nerd Font"
      font.pixelSize: 19
      font.letterSpacing: 1.5
    }

    Rectangle {
      id: fieldBox
      width: parent.width
      height: 50
      color: Qt.rgba(root.panel.r, root.panel.g, root.panel.b, 0.92)
      border.width: 2
      // At rest the border is a quiet version of the text colour so it survives any wallpaper;
      // focus and errors are the two states that earn the accent.
      border.color: root.statusIsError ? root.errorColor
                    : (field.activeFocus || field.text.length > 0 ? root.accent
                                                                  : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.35))
      radius: 0

      // shake on a failed attempt
      SequentialAnimation {
        id: shake
        NumberAnimation { target: fieldBox; property: "x"; to: -8; duration: 45 }
        NumberAnimation { target: fieldBox; property: "x"; to: 8; duration: 45 }
        NumberAnimation { target: fieldBox; property: "x"; to: -5; duration: 45 }
        NumberAnimation { target: fieldBox; property: "x"; to: 0; duration: 45 }
      }

      TextInput {
        id: field
        anchors.fill: parent
        anchors.leftMargin: 16
        anchors.rightMargin: 16
        verticalAlignment: TextInput.AlignVCenter
        echoMode: TextInput.Password
        passwordCharacter: "•"
        color: root.fg
        selectionColor: root.accent
        selectedTextColor: root.bg
        font.family: "JetBrainsMono Nerd Font"
        font.pixelSize: 17
        focus: true
        onTextChanged: root.password = text

        Text {
          anchors.fill: parent
          verticalAlignment: Text.AlignVCenter
          text: root.busy ? "checking..." : "password"
          color: root.fg
          opacity: 0.45
          font.family: field.font.family
          font.pixelSize: field.font.pixelSize
          visible: field.text.length === 0
        }

        Keys.onReturnPressed: root.submit()
        Keys.onEnterPressed: root.submit()
      }
    }

    Text {
      width: parent.width
      topPadding: 12
      horizontalAlignment: Text.AlignHCenter
      text: root.statusText
      color: root.statusIsError ? root.errorColor : root.muted
      font.family: "JetBrainsMono Nerd Font"
      font.pixelSize: 14
      visible: root.statusText.length > 0
    }

    Text {
      width: parent.width
      topPadding: 6
      horizontalAlignment: Text.AlignHCenter
      text: "CAPS LOCK"
      color: root.errorColor
      font.family: "JetBrainsMono Nerd Font"
      font.pixelSize: 13
      font.letterSpacing: 2
      visible: root.capsOn
    }
  }

  function submit() {
    if (root.busy)
      return;
    if (field.text.length === 0)
      return;
    root.busy = true;
    root.statusText = "";
    root.statusIsError = false;
    pam.start();
    // respond() must happen after the context is active; Quickshell emits responseRequired for that.
  }

  Connections {
    target: pam
    function onResponseRequiredChanged() {
      if (pam.responseRequired && root.busy)
        pam.respond(field.text);
    }
  }

  Component.onCompleted: field.forceActiveFocus()
}
