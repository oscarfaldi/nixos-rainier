  <action>
    <icon>applications-multimedia</icon>
    <name>Re-encode and Compress to HEVC MKV</name>
    <submenu>Media</submenu>
    <unique-id>1781935446753343-504</unique-id>
    <command>/home/oscarfaldi/System/.config/quickshell/scripts/qs-job reencode-and-compress-to-hevc-mkv %F</command>
    <description>Re-encode and compress selected videos to HEVC MKV for long-term storage</description>
    <range>*</range>
    <patterns>
        *.mp4;*.MP4;*.mov;*.MOV;
        *.mkv;*.MKV;*.webm;*.WEBM;
        *.m4v;*.M4V;*.avi;*.AVI;
        *.ts;*.TS;*.mts;*.MTS;
        *.m2ts;*.M2TS;*.mxf;*.MXF;
        *.wmv;*.WMV;*.asf;*.ASF;
        *.mpg;*.MPG;*.mpeg;*.MPEG;
        *.flv;*.FLV;*.f4v;*.F4V;
        *.ogv;*.OGV;*.3gp;*.3GP;
        *.3g2;*.3G2;*.vob;*.VOB;
        *.divx;*.DIVX
    </patterns>
    <video-files/>
  </action>

