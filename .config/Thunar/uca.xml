    <description>Move selected media files to NAS staging area</description>
    <range>*</range>
    <patterns>
        *.jpg;*.JPG;*.jpeg;*.JPEG;*.png;*.PNG;*.webp;*.WEBP;
        *.avif;*.AVIF;*.gif;*.GIF;*.bmp;*.BMP;*.tif;*.TIF;
        *.tiff;*.TIFF;*.heic;*.HEIC;*.heif;*.HEIF;*.jxl;*.JXL;
        *.raw;*.RAW;*.dng;*.DNG;*.cr2;*.CR2;*.cr3;*.CR3;
        *.nef;*.NEF;*.arw;*.ARW;*.rw2;*.RW2;*.orf;*.ORF;
        *.mp4;*.MP4;*.mov;*.MOV;*.mkv;*.MKV;*.webm;*.WEBM;
        *.avi;*.AVI;*.flv;*.FLV;*.wmv;*.WMV;*.m4v;*.M4V;
        *.mts;*.MTS;*.m2ts;*.M2TS;*.ts;*.TS;*.mpeg;*.MPEG;
        *.mpg;*.MPG;*.3gp;*.3GP;*.3g2;*.3G2;*.ogv;*.OGV;
        *.vob;*.VOB;*.mxf;*.MXF;*.insv;*.INSV;*.lrv;*.LRV
    </patterns>
    <image-files/>
    <video-files/>
  </action>

  <action>
      <icon>folder-remote</icon>
      <name>Move to NAS Music Staging</name>
      <submenu>NAS</submenu>
      <unique-id>1782052090035038-304</unique-id>
      <command>move-to-media-music-staging %F</command>
      <description>Move selected music folders to NAS staging area</description>
      <range>*</range>
